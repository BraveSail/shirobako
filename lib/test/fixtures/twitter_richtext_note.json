"h": 930, "resize": "fit", "w": 1200}, "small": {"h": 527, "resize": "fit", "w": 680}, "thumb": {"h": 150, "resize": "crop", "w": 150}}, "type": "photo", "url": "https://t.co/ZxA7AvNasl"}], "user_mentions": [{"id_str": "1447236165614989320", "indices": [62, 71], "name": "Keyu Tian 田柯宇", "screen_name": "keyutian"}]}, "extended_entities": {"media": [{"allow_download_status": {"allow_download": true}, "display_url": "pic.x.com/ZxA7AvNasl", "expanded_url": "https://x.com/MaxForAI/status/2108035230003274189/photo/1", "ext_media_availability": {"status": "Available"}, "features": {"large": {"faces": [{"h": 213, "w": 213, "x": 405, "y": 383}]}, "medium": {"faces": [{"h": 213, "w": 213, "x": 405, "y": 383}]}, "orig": {"faces": [{"h": 213, "w": 213, "x": 405, "y": 383}]}, "small": {"faces": [{"h": 120, "w": 120, "x": 229, "y": 217}]}}, "id_str": "2108035222524854272", "indices": [157, 180], "media_key": "3_2108035222524854272", "media_results": {"result": {"media_key": "3_2108035222524854272"}}, "media_url_https": "https://pbs.twimg.com/media/HUE-3bSbAAAp-Ci.jpg", "original_info": {"focus_rects": [{"h": 672, "w": 1200, "x": 0, "y": 0}, {"h": 930, "w": 930, "x": 0, "y": 0}, {"h": 930, "w": 816, "x": 0, "y": 0}, {"h": 930, "w": 465, "x": 158, "y": 0}, {"h": 930, "w": 1200, "x": 0, "y": 0}], "height": 930, "width": 1200}, "sizes": {"large": {"h": 930, "resize": "fit", "w": 1200}, "medium": {"h": 930, "resize": "fit", "w": 1200}, "small": {"h": 527, "resize": "fit", "w": 680}, "thumb": {"h": 150, "resize": "crop", "w": 150}}, "type": "photo", "url": "https://t.co/ZxA7AvNasl"}]}, "favorite_count": 546, "favorited": false, "full_text": "卧槽，当年轰动国内 AI 圈的“字节投毒实习生”田柯宇，现在杀回来了！\n\n刚刷到彭博今天专门发了一篇对他的采访。\n\n田柯宇 @keyutian  现在自己出来创业做世界模型，公司甚至还没有正式名字、没有产品，只有 10 个人，却已经从五源资本、IDG 等机构融了接近 3000 万美元，投后估值接近 2 亿美元。 https://t.co/ZxA7AvNasl", "id_str": "2108035230003274189", "is_quote_status": true, "lang": "zh", "possibly_sensitive": false, "possibly_sensitive_editable": true, "quote_count": 18, "quoted_status_id_str": "2108005744272371973", "quoted_status_permalink": {"display": "x.com/business/statu…", "expanded": "https://twitter.com/business/status/2108005744272371973", "url": "https://t.co/zkEc3l1fNj"}, "reply_count": 55, "retweet_count": 51, "retweeted": false, "user_id_str": "1699797396589588480"}, "note_tweet": {"is_expandable": true, "note_tweet_results": {"result": {"entity_set": {"hashtags": [], "symbols": [], "urls": [], "user_mentions": [{"id_str": "1447236165614989320", "indices": [62, 71], "name": "Keyu Tian 田柯宇", "screen_name": "keyutian"}]}, "id": "Tm90ZVR3ZWV0OjIxMDgwMzUyMjk5MDI2MjY4MTc=", "media": {"inline_media": []}, "richtext": {"richtext_tags": [{"from_index": 87, "richtext_types": ["Bold"], "to_index": 156}, {"from_index": 186, "richtext_types": ["Bold"], "to_index": 205}, {"from_index": 285, "richtext_types": ["Bold"], "to_index": 303}, {"from_index": 454, "richtext_types": ["Bold"], "to_index": 504}, {"from_index": 633, "richtext_types": ["Bold"], "to_index": 674}, {"from_index": 708, "richtext_types": ["Bold"], "to_index": 762}, {"from_index": 920, "richtext_types": ["Bold"], "to_index": 986}, {"from_index": 1031, "richtext_types": ["Bold"], "to_index": 1078}, {"from_index": 1191, "richtext_types": ["Bold"], "to_index": 1201}]}, "text": "卧槽，当年轰动国内 AI 圈的“字节投毒实习生”田柯宇，现在杀回来了！\n\n刚刷到彭博今天专门发了一篇对他的采访。\n\n田柯宇 @keyutian  现在自己出来创业做世界模型，公司甚至还没有正式名字、没有产品，只有 10 个人，却已经从五源资本、IDG 等机构融了接近 3000 万美元，投后估值接近 2 亿美元。\n\n而且这哥们现在做的东西还挺有意思。\n\n简单来说，他觉得：人类的语言其实根本不适合描述这个世界。\n\n比如你想用文字完整描述一段视频，里面每一个物体的位置、运动、光影、物理变化，基本是不可能的。\n\n所以他的思路是，干脆别让 AI 使用人类语言理解视频了。\n\n他们直接让 AI 自己发明一门语言。\n\n他们现在已经做出了一套类似词典的东西，里面大概有 20 万个符号，人类完全看不懂，但 AI 可以拿这些符号去表示、压缩和预测视频。\n\n接下来他们准备喂进去大约 1 亿小时的视频，让模型通过这套自己的语言去学习现实世界。\n\n最终目标不是视频生成，不是World Model，是希望做一个基座模型：\n\n让 AI 真正理解空间、运动和物理规律，未来可以作为机器人、自动驾驶、交互式视频这些东西的基础模型。\n\n田柯宇说，这套方法目前已经能让视频生成效率提升至少一个数量级。\n\n他们计划先做公开 Demo，甚至是直播，完整模型则准备在 2027 年发布。\n\n现阶段不着急做消费级产品，也暂时不考虑怎么商业化，就是先怼基座模型。\n\n田柯宇这个人，我其实之前就写过。\n\n他离开字节之后，他还作为一作拿了 NeurIPS 2024 Best Paper。\n\n那篇论文我当时专门看过，我印象特别深，因为它做的事情其实很暴力：就是想办法把视觉生成这件事，变得更像 LLM 一样，可以不断 Scaling，同时把生成成本和复杂度往下降。\n\n我当时看完就觉得，这个人能力是真的很牛逼。\n\n所以后来网上一直在讨论他当年在字节的事情，我其实也一直挺好奇到底发生了什么。\n\n因为当时中文互联网传得特别夸张，什么“投毒大模型”、造成几百万甚至八百万损失，各种版本都有，已经快传成 AI 圈都市传说了hhhh\n\n结果这次彭博终于把很多以前不知道的细节补出来了。\n\n田柯宇自己承认，当时他为了释放算力，直接关掉了另一个实习生超额占用计算资源的程序，他现在也觉得当时这种“以火攻火”的处理方式是错的。\n\n但另一方面，字节当年其实也明确说过，网上关于他破坏基础模型训练的很多传言存在误导。\n\n最后法院判下来的结果，是他因为违反合同赔偿 50 万人民币，把自己在字节拿到的工资全部退了回去\n\n这个结果跟当年网上传的那些版本，差距还是挺大的。\n\n所以我今天早上看到这篇采访还挺感慨的。\n\n因为我最早认识田柯宇这个名字，不是因为这次创业，甚至也不完全是因为字节那件事，而是后来真的去看了他的论文。\n\n当时我的感觉就是：这人确实是有东西的。\n\n现在再看，他离开字节之后拿 Best Paper，继续沿着自己的技术路线做世界模型，然后一个 10 人团队、产品都还没有，就融了接近 3000 万美元，估值快 2 亿美元。\n\n至少从技术能力这件事情上，我觉得之前那个判断没错。\n\n这个人，确实挺牛逼的。\n\n加油啊，等你们新的roadmap！"}}}, "quoted_status_result": {"result": {"__typename": "Tweet", "card": {"legacy": {"binding_values": [{"key": "photo_image_full_size_large", "value": {"image_value": {"height": 419, "url": "https://pbs.twimg.com/card_img/2108005748160573440/tBpoQMKV?format=jpg&name=800x419", "width": 800}, "type": "IMAGE"}}, {"key": "thumbnail_image", "value": {"image_value": {"height": 150, "url": "https://pbs.twimg.com/card_img/2108005748160573440/tBpoQMKV?format=jpg&name=280x150", "width": 200}, "type": "IMAGE"}}, {"key": "description", "value": {"string_value": "A former ByteDance Ltd. intern has secured funding from venture heavyweights including 5Y Capital for a stealth startup to take on AI pioneers such as Fei-Fei Li in the nascent realm of world models.", "type": "STRING"}}, {"key": "domain", "value": {"string_value": "www.bloomberg.com", "type": "STRING"}}, {"key": "thumbnail_image_large", "value": {"image_value": {"height": 300, "url": "https://pbs.twimg.com/card_img/2108005748160573440/tBpoQMKV?format=jpg&name=400x400", "width": 400}, "type": "IMAGE"}}, {"key": "summary_photo_image_small", "value": {"image_value": {"height": 202, "url": "https://pbs.twimg.com/card_img/2108005748160573440/tBpoQMKV?format=jpg&name=386x202", "width": 386}, "type": "IMAGE"}}, {"key": "thumbnail_image_or