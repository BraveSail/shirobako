# 复制为 .env 后填入自己的值（两份 Compose 均通过 env_file 读取）

# 可选：仅 docker-compose.yaml 使用；可固定为已发布的版本标签或 digest
# SHIROBAKO_IMAGE=ghcr.io/bravesail/shirobako:latest
# 宿主 Redis（默认值；已有 Redis 配置请保留）
# REDIS_URL=redis://127.0.0.1:6379/0

# ✅ 必填 — 登录 https://my.telegram.org 获取
API_ID=
API_HASH=
# 向 @BotFather 申请
BOT_TOKEN=

# 🔲 可选 — Bot 连接 Telegram 使用的代理, 例: http://127.0.0.1:7890
BOT_PROXY=

# Restrict inline / guest queries to members of this one group (0 = no restriction)
GUEST_WHITELIST_GROUP_ID=0
